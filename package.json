{
  "name": "octaneweb-react",
  "version": "2.4.4",
  "description": "OctaneWeb ported to React TypeScript with Node.js gRPC",
  "main": "dist/electron/main.js",
  "scripts": {
    "generate:proto": "bash scripts/generate-proto.sh",
    "cache:refresh": "node scripts/fetch-api-cache.js",
    "dev": "vite",
    "build:grpc-server": "npx tsc --target ES2020 --module commonjs --esModuleInterop --skipLibCheck --resolveJsonModule --moduleResolution node --outDir server/dist/.grpc-build server/src/grpc/GrpcProxyServer.ts && node -e \"const fs=require('fs'),p=require('path');const s='server/dist/.grpc-build/server/src/grpc',d='server/dist/grpc';fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s))fs.copyFileSync(p.join(s,f),p.join(d,f));const ms='server/dist/.grpc-build/mcp/src/shared',md='server/dist/grpc/mcp/src/shared';fs.mkdirSync(md,{recursive:true});for(const f of fs.readdirSync(ms))fs.copyFileSync(p.join(ms,f),p.join(md,f));fs.rmSync('server/dist/.grpc-build',{recursive:true})\"",
    "build": "tsc && tsc -p server/tsconfig.json && npm run build:grpc-server && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,css,json}\" \"*.md\"",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx,css,json}\" \"*.md\"",
    "lint": "eslint client/src",
    "lint:fix": "eslint client/src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mcp:build": "cd mcp && npm run build",
    "mcp:start": "cd mcp && npx tsx src/index.ts",
    "prepare": "husky",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:43929 && electron .\"",
    "electron:build": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win",
    "electron:build:dir": "npm run build && tsc -p electron/tsconfig.json && electron-builder --win --dir"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@tanstack/react-query": "^5.90.20",
    "@xyflow/react": "^12.10.0",
    "jpeg-js": "^0.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.1.0",
    "react-window": "^2.2.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.2.0",
    "google-protobuf": "^4.0.2",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.12.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "ts-protoc-gen": "^0.15.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^4.0.18",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.otoy.octanewebr",
    "productName": "octaneWebR",
    "directories": {
      "output": "dist/electron-build",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/client/**/*",
      "dist/electron/**/*",
      "server/dist/**/*",
      "../octaneServGrpc/proto/**/*",
      "mcp/src/shared/CallbackStreamManager.*",
      "mcp/data/octane-api-cache.json",
      "api-version.config.js",
      "grpc-constants.js"
    ],
    "extraResources": [
      {
        "from": "../octaneServGrpc/proto",
        "to": "server/proto"
      },
      {
        "from": "mcp/data/octane-api-cache.json",
        "to": "mcp/data/octane-api-cache.json"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "native/build/Release/dx_shared_surface.node",
        "to": "native/dx_shared_surface.node"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    }
  }
}
