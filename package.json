{
  "name": "octaneweb-react",
  "version": "1.5.9",
  "description": "OctaneWeb ported to React TypeScript with Node.js gRPC",
  "scripts": {
    "generate:proto": "bash scripts/generate-proto.sh",
    "cache:refresh": "node scripts/fetch-api-cache.js",
    "dev": "vite",
    "build": "tsc && tsc -p server/tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,css,json}\" \"*.md\"",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx,css,json}\" \"*.md\"",
    "lint": "eslint client/src",
    "lint:fix": "eslint client/src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mcp:build": "cd mcp && npm run build",
    "mcp:start": "cd mcp && npx tsx src/index.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "@xyflow/react": "^12.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.1.0",
    "react-window": "^2.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.2.0",
    "google-protobuf": "^4.0.2",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.12.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "ts-protoc-gen": "^0.15.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^4.0.18",
    "ws": "^8.18.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  }
}
