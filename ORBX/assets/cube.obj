# Unit cube centered at origin, 1x1x1
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
vn  0  0 -1
vn  0  0  1
vn -1  0  0
vn  1  0  0
vn  0 -1  0
vn  0  1  0
# Front face (-Z)
f 1//1 2//1 3//1 4//1
# Back face (+Z)
f 6//2 5//2 8//2 7//2
# Left face (-X)
f 5//3 1//3 4//3 8//3
# Right face (+X)
f 2//4 6//4 7//4 3//4
# Bottom face (-Y)
f 5//5 6//5 2//5 1//5
# Top face (+Y)
f 4//6 3//6 7//6 8//6
